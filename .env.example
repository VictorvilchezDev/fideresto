# Only the public API key. Never put a Supabase secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Stable HTTPS origin used for NFC links. Local preview may use http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solo laboratorio local ficticio. Desactivado en producción.
FIDERESTO_LOCAL_LAB=0

# Solo QR ficticio accesible desde otra máquina. Mantener desactivado en despliegues normales.
FIDERESTO_LAN_PREVIEW=0
FIDERESTO_DEMO_QR_ORIGIN=

# Wallet: rutas de ficheros del servidor; nunca valores NEXT_PUBLIC ni claves en Git.
WALLET_PUBLIC_ORIGIN=
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_SIGNER_CERT_FILE=
APPLE_WALLET_SIGNER_KEY_FILE=
APPLE_WALLET_WWDR_FILE=
APPLE_WALLET_KEY_PASSPHRASE=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CREDENTIALS_FILE=
# Solo habilita emisión de la tarjeta ficticia cuando existan credenciales reales.
FIDERESTO_WALLET_SAMPLE=0
